# ── Trump Market Watch — Environment Variables ──────────────────────────────
#
# Copy this file to .env and fill in your keys.
# NEVER commit .env to GitHub. It is already in .gitignore.
#

# Required: Anthropic API key (https://console.anthropic.com)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Optional: Finnhub API key for live stock prices (https://finnhub.io — free tier)
VITE_FINNHUB_API_KEY=your_finnhub_key_here
